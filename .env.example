# AnimeAV1 -> MyAnimeList Sync

# MyAnimeList OAuth
MAL_CLIENT_ID=TU_MAL_CLIENT_ID
MAL_CLIENT_SECRET=TU_MAL_CLIENT_SECRET
MAL_REDIRECT_URI=http://IP_DEL_EX4100:8787/oauth/callback

# Sincronización
SYNC_INTERVAL_MINUTES=60
AUTO_SYNC=false
DRY_RUN=true
ONLY_INCREASE=true
TITLE_MATCH_THRESHOLD=80

# Caché
CACHE_REVALIDATE_HOURS=24

# Aplicación
DATA_DIR=/data
LISTEN_ADDR=:8787
LOG_TIMEZONE=Europe/Madrid
